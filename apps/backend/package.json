    "@nestjs/swagger": "^12.0.0",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^7.10.0",
    "@web3-intelligence/blockchain": "workspace:*",
    "@web3-intelligence/shared": "workspace:*",
    "bullmq": "^5.34.3",
